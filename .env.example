# Discord bot environment example

# Discord bot
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_id_here
# optional: limit registration to a single guild during development
GUILD_ID=optional_guild_id_for_dev

# Default Minecraft server to monitor
SERVER_HOST=havenscraft.play.hosting
SERVER_PORT=23956

# Channel to post periodic updates / alerts (Discord channel ID)
STATUS_CHANNEL_ID=channel_id_here
POLL_INTERVAL_SECONDS=60

# RCON (optional) - if your server runs RCON
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password

# Prefix fallback
BOT_PREFIX=!
